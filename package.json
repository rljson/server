{
  "name": "@rljson/server",
  "version": "0.0.66",
  "description": "Rljson server description",
  "homepage": "https://github.com/rljson/server",
  "bugs": "https://github.com/rljson/server/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/server.git"
  },
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm exec vite build && tsc && node scripts/copy-readme-to-dist.js",
    "test": "pnpm exec vitest run --coverage && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "pnpm exec eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@rljson/dna-rljson": "^0.2.0",
    "@tssuite/helix-js": "^0.3.0",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "~10.10.0",
    "eslint-plugin-jsdoc": "^64.5.2",
    "eslint-plugin-tsdoc": "^0.5.3",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@rljson/bs": "0.0.26",
    "@rljson/db": "0.0.43",
    "@rljson/hash": "0.0.19",
    "@rljson/io": "0.0.79",
    "@rljson/json": "0.0.23",
    "@rljson/network": "0.0.22",
    "@rljson/rljson": "0.0.81"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@rljson/rljson": "0.0.81",
      "eslint-plugin-tsdoc>@typescript-eslint/utils": "^8.60.1"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
