{
  "name": "@rljson/server",
  "version": "0.0.50",
  "description": "Rljson server description",
  "homepage": "https://github.com/rljson/server",
  "bugs": "https://github.com/rljson/server/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/server.git"
  },
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm exec vite build && tsc && node scripts/copy-readme-to-dist.js",
    "test": "pnpm exec vitest run --coverage && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "pnpm exec eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "~9.39.2",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.6.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@rljson/bs": "0.0.25",
    "@rljson/db": "0.0.38",
    "@rljson/hash": "0.0.19",
    "@rljson/io": "0.0.73",
    "@rljson/json": "0.0.23",
    "@rljson/network": "0.0.20",
    "@rljson/rljson": "0.0.80"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@rljson/rljson": "^0.0.79"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
