{
  "name": "@rljson/server",
  "version": "0.0.34",
  "description": "Rljson server description",
  "homepage": "https://github.com/rljson/server",
  "bugs": "https://github.com/rljson/server/issues",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/server.git"
  },
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm exec vite build && tsc && node scripts/copy-readme-to-dist.js",
    "test": "pnpm exec vitest run --coverage && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "pnpm exec eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "eslint": "~9.39.4",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.4.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1",
    "vite-node": "^5.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2",
    "vitest-dom": "^0.1.1"
  },
  "dependencies": {
    "@rljson/bs": "^0.0.22",
    "@rljson/db": "^0.0.19",
    "@rljson/hash": "^0.0.18",
    "@rljson/io": "^0.0.68",
    "@rljson/json": "^0.0.23",
    "@rljson/network": "^0.0.12",
    "@rljson/rljson": "^0.0.78"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@rljson/rljson": "^0.0.78"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
