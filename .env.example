# Copy to .env and adjust for your environment.
# The Generator repo's setup-server-tables.ts script (a one-time,
# run-once-per-environment step) must point at these SAME MSSQL_* values.

# "mssql" (default, persistent) or "mem" (in-memory, dev/test only, data lost on exit)
IO_BACKEND=mssql

MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=rljson
MSSQL_SCHEMA=PantrySchema
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
# Max concurrent MSSQL connections in the pool (default 25, up from the
# mssql package's own default of 10) -- raised because the Server's own
# concurrent table provisioning and archival-walk fan out many
# simultaneous requests against this one pool; a large batch (e.g. a
# generate run with a high --count) can want more than 10 in flight.
MSSQL_POOL_MAX=25

# Comma-separated list of routes to host — one per independent entity type
# clients sync (e.g. every entry in the Generator repo's
# src/generators/index.ts registry). Each route gets its own Server instance
# and its own Socket.IO namespace (${SERVER_URL}${route}, e.g.
# http://localhost:3000/customerCake) — a Client/Server pair is single-route.
# RLJSON_ROUTE (singular) remains supported for a single-route setup.
# Add a route here (comma-separated) whenever a new entity type is
# registered in the Generator's generators/index.ts, e.g.
# "customerCake,productCake".
RLJSON_ROUTES=customerCake

# HTTP/Socket.IO port the server listens on
PORT=3000
