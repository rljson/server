{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/server",

  // 1-2 sentence summary about this repo.
  "summary": "Network layer of Rljson. Node: one port in every role, a hub service for every route (HubRoutes, one Server each), route members that follow the elected hub (ClientRoute in process, WorkerRoute in a worker over ChannelSocket). Client keeps writes local and pulls by ref (local, peers, hub). Peer reads: read announced data from its sender first, hub as fallback.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "star sync: refs flow through the hub, data is pulled on demand",
    "a node's whole lifecycle: election, hub service, route members, workers",
    "hub load: peer reads from the sending node, bounded, read-only, one hop",
    "sync protocol on the hub: ACK, gap-fill, stamps, bootstrap, state beacon, backpressure"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "rljson": "ConnectorPayload (src), syncEvents, RefStamp, Route",
      "io": "Io, IoMulti, IoPeer, IoPeerBridge, IoServer, IoMem",
      "bs": "Bs, BsMulti, BsPeer, BsPeerBridge, BsServer, BsMem",
      "db": "Db, Connector, stateBeaconEvent",
      "network": "NetworkManager: roles, topology, resolvePeerAddress"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "fs-agent": "Client (io/bs/socket) for file sync",
      "mongo-agent": "Client for collection sync",
      "cos-one-client": "Node (port transport, hub stores, members), Server, Client"
    }
  }
}
